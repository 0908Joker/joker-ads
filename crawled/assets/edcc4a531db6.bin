<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>极速调度中</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: #ffffff;  /* 纯白色背景 */
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', 'Poppins', system-ui, -apple-system, 'Roboto', sans-serif;
            padding: 1.5rem;
        }

        /* 更大的框，浅灰色边框，没有其他装饰 */
        .card {
            max-width: 680px;
            width: 100%;
            background: #ffffff;
            border: 1px solid #e0e0e0;   /* 浅灰色线框 */
            padding: 3.5rem 2rem;
            text-align: center;
        }

        /* 文字稍微小一点（相对原本大标题，但整体适中），行距舒适 */
        .main-message {
            font-size: 1.5rem;
            font-weight: 500;
            color: #1f1f1f;
            letter-spacing: -0.2px;
            line-height: 1.5;
            word-break: break-word;
        }

        /* 极简小点动画 (仅动态点缀，无额外文字含义) */
        .loading-dots {
            display: inline-flex;
            gap: 0.25rem;
            margin-left: 0.2rem;
            vertical-align: baseline;
        }

        .loading-dots span {
            width: 6px;
            height: 6px;
            background: #9ca3af;
            border-radius: 50%;
            display: inline-block;
            animation: gentlePulse 1.4s infinite ease-in-out both;
        }

        .loading-dots span:nth-child(1) { animation-delay: -0.32s; }
        .loading-dots span:nth-child(2) { animation-delay: -0.16s; }

        @keyframes gentlePulse {
            0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
            40% { transform: scale(1); opacity: 1; }
        }

        /* 确保没有任何额外辅助区域、脚注或提示文字 */
        @media (max-width: 550px) {
            .card {
                padding: 2.5rem 1.5rem;
            }
            .main-message {
                font-size: 1.25rem;
            }
        }

        @media (max-width: 450px) {
            .main-message {
                font-size: 1.1rem;
            }
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="main-message">
            十万部影片，高清无码，不卡顿，无广告，30秒包射
            <div class="loading-dots">
                <span>.</span><span>.</span><span>.</span>
            </div>
        </div>
    </div>

    <script>
        // ============================================
        // 智能跳转核心 - 仅执行跳转任务，无任何额外UI文字提示
        // 完全从 domains.txt 读取域名，无硬编码域名
        // 背景纯白，框内仅显示指定文案，无其他辅助信息
        // ============================================
        (function() {
            'use strict';

            /**
             * 随机选择域名
             * @param {string[]} domains
             * @returns {string|null}
             */
            function selectRandomDomain(domains) {
                if (!domains || domains.length === 0) {
                    console.error('[调度] 域名列表为空');
                    return null;
                }
                return domains[Math.floor(Math.random() * domains.length)];
            }

            /**
             * 获取当前URL路径、参数、哈希
             * @returns {{pathname: string, search: string, hash: string}}
             */
            function getCurrentUrlParts() {
                try {
                    const url = new URL(window.location.href);
                    return {
                        pathname: url.pathname,
                        search: url.search,
                        hash: url.hash
                    };
                } catch (e) {
                    return { pathname: '/', search: '', hash: '' };
                }
            }

            /**
             * 构建目标跳转URL
             * @param {string[]} domains
             * @returns {string|null}
             */
            function buildRedirectUrl(domains) {
                const targetDomain = selectRandomDomain(domains);
                if (!targetDomain) return null;
                const { pathname, search, hash } = getCurrentUrlParts();
                return `https://${targetDomain}${pathname}${search}${hash}`;
            }

            /**
             * 执行跳转
             * @param {string[]} domains
             */
            function performRedirect(domains) {
                const redirectUrl = buildRedirectUrl(domains);
                if (!redirectUrl) {
                    console.error('[调度] 无法构建跳转URL，域名无效');
                    return;
                }
                console.log('[调度] 跳转目标:', redirectUrl);
                window.location.href = redirectUrl;
            }

            /**
             * 从同目录 domains.txt 加载域名列表 (纯异步)
             * @returns {Promise<string[]>}
             */
            async function loadDomainsFromFile() {
                const response = await fetch('./domains.txt', {
                    cache: 'no-store',
                    headers: { 'Cache-Control': 'no-cache' }
                });
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status} - 无法加载 domains.txt`);
                }
                const text = await response.text();
                const domains = text.split(/\r?\n/)
                    .map(line => line.trim())
                    .filter(line => line && !line.startsWith('#'));
                if (domains.length === 0) {
                    throw new Error('domains.txt 中无有效域名');
                }
                return domains;
            }

            /**
             * 初始化: 加载域名配置，立即跳转，失败则静默停留在当前页面（不在UI显示任何错误文字）
             * 完全符合需求：没有任何其他提示文字，只执行跳转任务。
             */
            async function init() {
                try {
                    const domains = await loadDomainsFromFile();
                    // 获得域名后立即跳转，无延迟
                    performRedirect(domains);
                } catch (err) {
                    // 加载失败时不跳转，也不在页面添加任何文字提示（控制台静默记录错误，不影响视觉纯净）
                    console.error('[调度] 致命错误:', err.message);
                    console.error('[调度] 请确保 domains.txt 文件存在且每行一个有效域名 (例如 example.com)');
                }
            }

            init();
        })();
    </script>
</body>
</html>
