<script type="text/javascript" charset="UTF-8" src="https://res.opstatistics.com/openinstall-myfmzf.js" 
        onerror="loadBackupOpenInstall()"></script>
<script type="text/javascript">
    // 备用 CDN 加载函数
    var backupOpenInstallLoaded = false;
    function loadBackupOpenInstall() {
        if (backupOpenInstallLoaded) return;
        backupOpenInstallLoaded = true;
        console.log("主 CDN 加载失败，切换到备用 CDN");
        var script = document.createElement('script');
        script.type = 'text/javascript';
        script.charset = 'UTF-8';
        script.src = 'https://web.cdn.openinstall.io/openinstall.js';
        script.onerror = function() {
            console.log("备用 CDN 也加载失败，使用兜底下载");
        };
        document.head.appendChild(script);
    }
</script>
<script type="text/javascript" src="/static/mb5/js/vue3.js"></script>

<script>
    // 全局变量，供后台统计代码使用
    var appKey = "myfmzf";
    var channelCode = "xjjn1";
    var CONFIG = {
        android_base: "https://q419rf269vxq.gte0clrtn0m3.dbmtei.cn/DH173/oazdsa",
        ios_base: "https://jxnge69.gugxc.com/d/2bingsxd8yw81w8"
    };

    // 检查 URL 是否有效（非空且去除空格后不为空）
    function isValidUrl(url) {
        return url && typeof url === 'string' && url.trim().length > 0;
    }

    // 设备检测函数
    function isIOS() {
        let ua = navigator.userAgent || navigator.vendor || window.opera;
        return /iPad|iPhone|iPod/.test(ua) && !window.MSStream;
    }

    function isAndroid() {
        let ua = navigator.userAgent || navigator.vendor || window.opera;
        return /android/i.test(ua);
    }

    // 兜底下载函数
    let fallbackDownload = function() {
        const hasAndroidUrl = isValidUrl(CONFIG.android_base);
        const hasIosUrl = isValidUrl(CONFIG.ios_base);

        // 判断是否有下载链接，如果没有则不跳转
        if (!hasAndroidUrl && !hasIosUrl) {
            console.warn("未配置下载链接，无法执行兜底下载");
            return;
        }

        let ua = navigator.userAgent || navigator.vendor || window.opera;
        if (/android/i.test(ua)) {
            if (hasAndroidUrl) {
                window.location.href = CONFIG.android_base.trim();
            } else {
                console.warn("未配置 Android 下载链接");
            }
        } else if (/iPad|iPhone|iPod/.test(ua) && !window.MSStream) {
            if (hasIosUrl) {
                window.location.href = CONFIG.ios_base.trim();
            } else {
                console.warn("未配置 iOS 下载链接");
            }
        } else {
            // 默认跳 Android 地址
            if (hasAndroidUrl) {
                window.location.href = CONFIG.android_base.trim();
            } else if (hasIosUrl) {
                window.location.href = CONFIG.ios_base.trim();
            } else {
                console.warn("未配置任何下载链接");
            }
        }
    };

    // 给所有 .all-download 按钮绑定兜底下载（默认行为）
    function bindFallbackToButtons() {
        var downloadBtns = document.querySelectorAll('.all-download');
        downloadBtns.forEach(function(btn) {
            btn.onclick = function() {
                fallbackDownload();
                return false;
            };
        });
    }

    // 初始化 OpenInstall
    try {
        // 检查 OpenInstall 是否已加载
        if (typeof OpenInstall === 'undefined') {
            console.log("OpenInstall SDK 未加载，使用兜底下载");
            throw new Error("OpenInstall SDK 未加载");
        }

        var data = OpenInstall.parseUrlParams();
        var openInstallInitialized = false;
        var openInstallServiceHealthy = true;

        // 监听网络错误，检测 OpenInstall 服务是否可用
        var originalFetch = window.fetch;
        var originalXHROpen = XMLHttpRequest.prototype.open;
        var openInstallErrorDetected = false;

        // 拦截 fetch 请求
        if (originalFetch) {
            window.fetch = function() {
                return originalFetch.apply(this, arguments).catch(function(err) {
                    if (arguments[0] && arguments[0].includes && arguments[0].includes('openinstall.com')) {
                        console.log("检测到 OpenInstall 服务请求失败");
                        openInstallServiceHealthy = false;
                        openInstallErrorDetected = true;
                    }
                    throw err;
                });
            };
        }

        // 拦截 XMLHttpRequest
        XMLHttpRequest.prototype.open = function(method, url) {
            this.addEventListener('error', function() {
                if (url && url.includes('openinstall.com')) {
                    console.log("检测到 OpenInstall 服务请求失败");
                    openInstallServiceHealthy = false;
                    openInstallErrorDetected = true;
                }
            });
            return originalXHROpen.apply(this, arguments);
        };

        var openInstall = new OpenInstall({
            appKey: appKey,
            channelCode: channelCode,
            fastInstall: false,
            onready: function() {
                openInstallInitialized = true;
                console.log("OpenInstall SDK 初始化成功");
                //this.schemeWakeup();

                var m = this;

                // 延迟 500ms 检查服务健康状态，给网络请求时间
                setTimeout(function() {
                    // 如果检测到服务错误，不覆盖默认兜底
                    if (openInstallErrorDetected) {
                        console.log("OpenInstall 服务不可用，保持默认兜底下载");
                        return;
                    }

                    // 服务正常，覆盖默认行为
                    console.log("OpenInstall 服务正常，启用唤起功能");
                    var downloadBtns = document.querySelectorAll('.all-download');
                    downloadBtns.forEach(function(btn) {
                        btn.setAttribute("data-init-ok", "true");
                        btn.onclick = function() {
                            // 再次检查服务状态
                            if (!openInstallServiceHealthy) {
                                console.log("OpenInstall 服务不可用，使用兜底下载");
                                fallbackDownload();
                                return false;
                            }

                            let isOpened = false;
                            let hasResponded = false;

                            const quickTimer = setTimeout(function() {
                                if (!hasResponded) {
                                    console.log("OpenInstall 响应超时，执行兜底下载");
                                    fallbackDownload();
                                }
                            }, 3000);

                            const wakeupTimer = isIOS() ? setTimeout(function() {
                                if (!isOpened) {
                                    console.log("未唤起APP，执行兜底下载");
                                    fallbackDownload();
                                }
                            }, 3000) : null;

                            try {
                                m.wakeupOrInstall({
                                    channelCode: channelCode,
                                    onsuccess: function() {
                                        hasResponded = true;
                                        isOpened = true;
                                        clearTimeout(quickTimer);
                                        if (wakeupTimer) clearTimeout(wakeupTimer);
                                    },
                                    onfail: function(err) {
                                        hasResponded = true;
                                        console.log("唤起失败，使用兜底下载:", err);
                                        clearTimeout(quickTimer);
                                        if (wakeupTimer) clearTimeout(wakeupTimer);
                                        fallbackDownload();
                                    }
                                });
                            } catch(e) {
                                hasResponded = true;
                                console.log("调用 wakeupOrInstall 异常，使用兜底下载:", e);
                                clearTimeout(quickTimer);
                                if (wakeupTimer) clearTimeout(wakeupTimer);
                                fallbackDownload();
                            }
                            return false;
                        };
                    });
                }, 500);
            },
            onerror: function(err) {
                console.log("OpenInstall 初始化失败，使用兜底下载:", err);
                openInstallInitialized = false;
                bindFallbackToButtons();
            }
        }, data);

        setTimeout(function() {
            if (!openInstallInitialized) {
                console.log("OpenInstall 初始化超时，使用兜底下载");
                bindFallbackToButtons();
            }
        }, 3000);
    } catch(e) {
        console.log("OpenInstall 初始化异常，使用兜底下载:", e);
        bindFallbackToButtons();
    }

    // Vue3 实例化
    const app = Vue.createApp({
        data() {
            return {
                appKey: appKey,
                channelCode: channelCode,
                intro_index: 0,
            }
        },
        methods: {
            intro() {
                this.intro_index = (this.intro_index + 1);
            },
        },
        mounted() {
            window.vueApp = this;
        },
    })
    app.mount('#app')
</script>
